{
  "name": "@letterpress/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm build:compiler && pnpm -r build",
    "build:compiler": "node scripts/build-compiler.mjs",
    "test": "pnpm -r test",
    "typecheck": "tsc -p compiler/tsconfig.json --noEmit && pnpm -r typecheck",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write --unsafe .",
    "check:exports": "pnpm -r build && pnpm -r run check:publish",
    "check:conformance": "node scripts/check-conformance.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "check:release": "node scripts/release.mjs check --allow-untagged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.10",
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-liquid": "6.3.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^26.2.0",
    "@types/mjml": "^4.7.4",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.2",
    "publint": "^0.3.23",
    "@lezer/highlight": "^1.2.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@shopify/liquid-html-parser": "2.10.0",
    "@shopify/prettier-plugin-liquid": "1.11.0",
    "mjml": "5.4.0",
    "mjml-core": "5.4.0",
    "mjml-preset-core": "5.4.0",
    "prettier": "^3.6.2"
  }
}
