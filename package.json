{
  "name": "@letterpress/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "pnpm build:compiler && pnpm -r build",
    "build:compiler": "node scripts/build-compiler.mjs",
    "test": "vitest run compiler && pnpm -r test",
    "typecheck": "tsc -p compiler/tsconfig.json --noEmit && pnpm -r typecheck",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write --unsafe .",
    "check:exports": "pnpm -r build && pnpm -r run check:publish",
    "check:conformance": "node scripts/check-conformance.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "check:release": "node scripts/release.mjs check --allow-untagged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-liquid": "6.3.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/mjml": "^5.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@shopify/liquid-html-parser": "2.10.2",
    "@shopify/prettier-plugin-liquid": "1.11.2",
    "mjml": "5.4.1",
    "mjml-core": "5.4.1",
    "mjml-preset-core": "5.4.1",
    "prettier": "^3.9.10"
  }
}
