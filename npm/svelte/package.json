{
  "name": "@letterpress/svelte",
  "version": "0.1.2",
  "description": "An accessible, themeable Svelte 5 editor shell for Letterpress.",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs dist && svelte-package --input src --output dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --coverage",
    "check:publish": "publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error -q"
  },
  "peerDependencies": {
    "@letterpress/language": "^0.1.0",
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@letterpress/language": "workspace:^"
  },
  "homepage": "https://github.com/futhr/letterpress",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futhr/letterpress.git",
    "directory": "npm/svelte"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
