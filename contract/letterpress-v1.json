{
  "contract_version": 1,
  "artifact_version": 1,
  "diagnostic_version": 1,
  "schema_version": 1,
  "profiles": {
    "email/mjml-liquid@1": {
      "kind": "email",
      "language": "mjml-liquid",
      "compiler": "mjml@5.4.0",
      "root": "mjml",
      "elements": [
        "mjml",
        "mj-head",
        "mj-body",
        "mj-attributes",
        "mj-all",
        "mj-class",
        "mj-breakpoint",
        "mj-font",
        "mj-preview",
        "mj-style",
        "mj-title",
        "mj-html-attributes",
        "mj-selector",
        "mj-html-attribute",
        "mj-wrapper",
        "mj-section",
        "mj-group",
        "mj-column",
        "mj-text",
        "mj-button",
        "mj-image",
        "mj-divider",
        "mj-spacer",
        "mj-table",
        "mj-social",
        "mj-social-element",
        "mj-navbar",
        "mj-navbar-link",
        "mj-hero",
        "mj-raw",
        "mj-accordion",
        "mj-accordion-element",
        "mj-accordion-title",
        "mj-accordion-text",
        "mj-carousel",
        "mj-carousel-image"
      ],
      "forbidden_elements": ["mj-include"],
      "url_attributes": ["href", "src", "background-url", "action"],
      "color_attributes": ["color", "background-color", "border-color"],
      "text_elements": [
        "mj-text",
        "mj-button",
        "mj-title",
        "mj-preview",
        "mj-navbar-link",
        "mj-accordion-title",
        "mj-accordion-text"
      ],
      "structural_elements": ["mj-body", "mj-wrapper", "mj-section", "mj-group", "mj-column"],
      "common_attributes": ["css-class", "mj-class"]
    },
    "text/liquid@1": {
      "kind": "text",
      "language": "liquid",
      "root": null,
      "elements": [],
      "forbidden_elements": []
    }
  },
  "liquid": {
    "tags": ["if", "unless", "for", "case", "comment", "break", "continue"],
    "filters": [
      "abs",
      "append",
      "at_least",
      "at_most",
      "capitalize",
      "ceil",
      "compact",
      "concat",
      "date",
      "default",
      "divided_by",
      "downcase",
      "first",
      "floor",
      "join",
      "last",
      "lstrip",
      "map",
      "minus",
      "modulo",
      "newline_to_br",
      "plus",
      "prepend",
      "remove",
      "remove_first",
      "replace",
      "replace_first",
      "reverse",
      "round",
      "rstrip",
      "size",
      "slice",
      "sort",
      "sort_natural",
      "split",
      "strip",
      "strip_html",
      "strip_newlines",
      "times",
      "truncate",
      "truncatewords",
      "uniq",
      "upcase",
      "url_decode",
      "url_encode",
      "where"
    ],
    "reserved_filters": ["letterpress_escape"]
  },
  "embedded_html": {
    "elements": [
      "a",
      "abbr",
      "b",
      "blockquote",
      "br",
      "caption",
      "code",
      "div",
      "em",
      "h1",
      "h2",
      "h3",
      "h4",
      "h5",
      "h6",
      "hr",
      "i",
      "img",
      "li",
      "ol",
      "p",
      "pre",
      "small",
      "span",
      "strong",
      "sub",
      "sup",
      "table",
      "tbody",
      "td",
      "tfoot",
      "th",
      "thead",
      "tr",
      "u",
      "ul"
    ],
    "global_attributes": [
      "align",
      "aria-label",
      "class",
      "dir",
      "height",
      "id",
      "lang",
      "role",
      "style",
      "title",
      "valign",
      "width"
    ],
    "attributes": {
      "a": ["href", "rel", "target"],
      "img": ["alt", "src"],
      "li": ["value"],
      "ol": ["reversed", "start", "type"],
      "table": ["border", "cellpadding", "cellspacing", "summary"],
      "td": ["colspan", "headers", "rowspan", "scope"],
      "th": ["abbr", "colspan", "headers", "rowspan", "scope"],
      "ul": ["type"]
    },
    "url_attributes": ["href", "src"]
  },
  "contexts": ["text", "html_text", "html_attribute", "url", "color", "css", "subject", "none"],
  "phases": ["compile", "delivery"],
  "types": [
    "string",
    "integer",
    "number",
    "boolean",
    "date",
    "datetime",
    "url",
    "email",
    "phone",
    "object",
    "list"
  ],
  "snippets": {
    "email": [
      {
        "label": "email document",
        "template": "<mjml>\n  <mj-head>\n    <mj-preview>${1:Preview}</mj-preview>\n  </mj-head>\n  <mj-body>\n    <mj-section>\n      <mj-column>\n        <mj-text>${2:Content}</mj-text>\n      </mj-column>\n    </mj-section>\n  </mj-body>\n</mjml>"
      },
      {
        "label": "conditional section",
        "template": "{% if ${1:condition} %}\n  <mj-section>\n    <mj-column>\n      <mj-text>${2:Content}</mj-text>\n    </mj-column>\n  </mj-section>\n{% endif %}"
      }
    ],
    "text": [
      { "label": "conditional text", "template": "{% if ${1:condition} %}${2:Text}{% endif %}" },
      { "label": "variable", "template": "{{ ${1:variable} }}" }
    ]
  },
  "diagnostic_codes": [
